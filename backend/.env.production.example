# Server
GO_ENV=production
PORT=8080

# Database — sslmode=require mandatory in production
DATABASE_DSN=postgres://user:pass@host:5432/command_center?sslmode=require

# Auth — minimum 32 characters
JWT_SECRET=replace-with-64-char-random-string-generated-by-openssl

# CORS — comma-separated, no trailing slash
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Slack
SLACK_BOT_TOKEN=xoxb-your-token
SLACK_CHANNEL_ID=C0XXXXXXXXX

# Google Sheets (optional)
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Anthropic (Phase 4)
ANTHROPIC_API_KEY=

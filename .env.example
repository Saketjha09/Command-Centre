# Command Centre — Global Environment Variables
# Copy this file to .env and fill in your secrets.
# Do NOT commit .env to version control.

# --- Database ---
# Full PostgreSQL connection string.
# Format: postgres://user:password@host:port/dbname?sslmode=disable
DATABASE_DSN=postgres://postgres:postgres@localhost:5432/command_center?sslmode=disable

# --- Security ---
# Signing secret for JWT access tokens. Must be >= 32 characters of random data.
JWT_SECRET=change_me_to_at_least_32_characters_of_random_data_now

# --- HTTP Server ---
# The port the backend API will listen on.
PORT=8080

# --- Slack Integration ---
# Your Slack OAuth Bot Token (starts with xoxb-).
SLACK_BOT_TOKEN=xoxb-your-token-here

# --- Slack Channel ---
# The ID of the channel where task notifications will be sent.
SLACK_CHANNEL_ID=C0123456789

# --- Optional Extras ---
# Google Sheets ID for payroll automation.
GOOGLE_SHEETS_ID=
# Base64-encoded Google Service Account JSON.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Execution environment (development | production)
GO_ENV=development

# CORS: comma-separated list of allowed origins.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Missing Secrets ---
SLACK_SIGNING_SECRET=your_slack_signing_secret_here
GOOGLE_DRIVE_SHARE_EMAIL=your_service_account_email_here
GOOGLE_DRIVE_PARENT_ID=your_drive_folder_id_here

# --- Database Initialization ---
# Run migrations manually before first boot:
# psql $DATABASE_DSN -f backend/db/migrations/001_initial_schema.sql
# ... through 017
